#!/command/with-contenv bashio
# ==============================================================================
# Home Assistant App: App Migration Assistant
# Checks the environment the migration will run in
# ==============================================================================
declare protected

bashio::log.info 'Preparing the App Migration Assistant...'

if ! bashio::supervisor.ping; then
    bashio::exit.nok 'Supervisor is not reachable'
fi

protected=$(bashio::addon.protected 'self')
if bashio::var.true "${protected}"; then
    bashio::log.warning
    bashio::log.warning 'Protection mode is enabled for this app.'
    bashio::log.warning
    bashio::log.warning 'Without access to Docker, the app can copy the options of'
    bashio::log.warning 'an app, but not its internal data. Turn protection mode off'
    bashio::log.warning 'in the app info panel and restart this app.'
    bashio::log.warning
else
    bashio::log.info 'Protection mode is disabled, Docker access is available'
fi

mkdir -p /config/plans
